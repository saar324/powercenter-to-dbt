# Preserve raw test transcripts; whitespace in captured output is evidence.
reports/evidence/*.txt -whitespace
reports/evidence/**/*.txt -whitespace
# csv.DictWriter uses standard CRLF record endings.
reports/test-runs.csv whitespace=cr-at-eol
# Preserve exact captured user prompts, including trailing spaces.
docs/agent-prompts.md -whitespace
# Preserve byte-pinned upstream fixtures, including their original whitespace.
fixtures/references/classic/** -whitespace
fixtures/references/modern/** -whitespace
fixtures/references/dbt_utils/** -whitespace
